# wrapper-lite endpoint as seen from inside the container.
# Default is wrapper-lite running on the Docker host.
# AMDL_LITE_SERVER=http://192.168.1.10:12340

# Uid/gid the downloader runs as (output of `id -u` / `id -g`).
PUID=1000
PGID=1000

# TZ=Asia/Shanghai
# AMDL_IMAGE=ghcr.io/zhaarey/apple-music-downloader:latest
